{
  "name": "speccore",
  "version": "8.3.374",
  "description": "SpecCore - Code by Spec, Not by Vibe.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "speccore": "bin/speccore"
  },
  "scripts": {
    "build": "node sync-version.js && tsc && node build-post.js",
    "sync-version": "node sync-version.js",
    "watch": "tsc --watch",
    "prepublish": "npm run build",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts",
    "release:verify": "bash scripts/release.sh verify",
    "release:beta": "bash scripts/release.sh beta",
    "release:stable": "bash scripts/release.sh stable"
  },
  "keywords": [
    "spec-driven-development",
    "ai",
    "cli",
    "code-generation",
    "spec"
  ],
  "author": "SpecCore Team <windfallsheng@aliyun.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windfallsheng/SpecCore-ts.git"
  },
  "files": [
    "dist",
    "bin",
    ".agents",
    "vendor",
    "templates"
  ],
  "dependencies": {
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "pinyin-pro": "^3.29.4",
    "playwright": "^1.62.1",
    "typescript": "^5.3.3",
    "web-tree-sitter": "0.20.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.5",
    "@vitest/coverage-v8": "^1.6.1",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "@qoder-ai/qoder-agent-sdk": "^1.0.41",
    "exceljs": "^4.4.0"
  }
}
