    "description": "归档已完成的迭代",
    "prompt": "归档 {迭代名} 迭代",
    "command": "speccore archive -I {迭代名}",
    "env": "cli",
    "params": [
      { "key": "迭代名", "placeholder": "Q1", "required": true }
