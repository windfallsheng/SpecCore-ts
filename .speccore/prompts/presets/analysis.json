[
  {
    "id": "import-doc",
    "name": "导入需求文档",
    "category": "analysis",
    "icon": "📄",
    "description": "将 Word/PDF 需求文档转换为 Markdown 规格",
    "prompt": "把 {文件路径} 导入到 {迭代名} 迭代，端是 {平台}",
    "command": "speccore doc2spec -f {文件路径} --iter {迭代名} -p {平台}",
    "env": "both",
    "skill": "spec-doc2spec",
    "params": [
      {
        "key": "文件路径",
        "placeholder": "docs/PRD.docx",
        "required": true
      },
      {
        "key": "迭代名",
        "placeholder": "Q2",
        "required": true
      },
      {
        "key": "平台",
        "placeholder": "admin",
        "required": false
      }
    ],
    "tags": [
      "分析阶段",
      "文档处理"
    ],
    "builtin": true,
    "sort": 1,
    "examples": [
      "新项目中首次导入 PRD 文档",
      "客户发来 Word 版需求需要转为规格"
    ]
  },
